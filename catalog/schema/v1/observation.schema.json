{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gettakaro/connectors/catalog/schema/v1/observation.schema.json",
  "title": "Upstream observation",
  "description": "One upstream fact a provider saw, as the tracker carries it. Provider-specific detail lives in 'facts'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "component", "branch", "rev", "kind", "identity", "facts", "observedAt", "source"],
  "properties": {
    "schemaVersion": {"const": 1},
    "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "component": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "branch": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._+/-]+$"},
    "rev": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._+/-]+$"},
    "kind": {"enum": ["game", "framework", "branch-review"]},
    "identity": {"type": "string", "minLength": 1},
    "facts": {"type": "object", "description": "Provider-specific. The mojang provider records id, type, releaseTime, manifestList, manifest, server and javaMajor."},
    "observedAt": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["game", "id"],
      "properties": {
        "game": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "id": {"type": "string", "minLength": 1}
      }
    }
  }
}
