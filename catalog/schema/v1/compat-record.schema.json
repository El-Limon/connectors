{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gettakaro/connectors/catalog/schema/v1/compat-record.schema.json",
  "title": "Compatibility record",
  "description": "What one release of one connector contains: the exact inputs, source revision, target fingerprint, verification level, hashes and download links for every published asset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "connector",
    "version",
    "channel",
    "tag",
    "mode",
    "generatedAt",
    "tool",
    "source",
    "catalog",
    "targets",
    "aliases",
    "assets",
    "checksums",
    "self"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "compat-record"},
    "connector": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "channel": {"enum": ["stable", "rolling", "pr"]},
    "tag": {"type": "string", "minLength": 1},
    "mode": {"enum": ["catalog", "legacy"]},
    "generatedAt": {"type": "string", "minLength": 20},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "commit", "tag", "dirty", "catalogSha256"],
      "properties": {
        "repo": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tag": {"type": ["string", "null"]},
        "dirty": {"type": "boolean"},
        "catalogSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "catalog": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["game", "targetIds"],
          "properties": {
            "game": {"type": "string", "minLength": 1},
            "targetIds": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "revision", "status", "fingerprint", "inputs", "runtime", "verification", "artifacts"],
        "properties": {
          "platform": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1},
          "status": {"enum": ["candidate", "maintained"]},
          "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "url"],
              "properties": {
                "kind": {"type": "string", "minLength": 1},
                "url": {"type": ["string", "null"]},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "size": {"type": "integer", "minimum": 0},
                "version": {"type": "string", "minLength": 1}
              }
            }
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": ["image", "tag", "digest"],
            "properties": {
              "image": {"type": "string", "minLength": 1},
              "tag": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "executed", "report", "outcome", "takaro"],
            "properties": {
              "required": {"enum": ["none", "build", "contract", "startup", "protocol", "gameplay"]},
              "executed": {"oneOf": [{"type": "null"}, {"enum": ["none", "build", "contract", "startup", "protocol", "gameplay"]}]},
              "report": {"type": ["string", "null"]},
              "outcome": {"oneOf": [{"type": "null"}, {"enum": ["pass", "fail"]}]},
              "takaro": {"oneOf": [{"type": "null"}, {"enum": ["local", "hosted"]}]}
            }
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "name", "sha256", "size", "url"],
              "properties": {
                "role": {"type": "string", "minLength": 1},
                "name": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "size": {"type": "integer", "minimum": 1},
                "url": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "role", "of", "sha256"],
        "properties": {
          "target": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "of": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "sha256", "size", "url"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["artifact", "alias", "verify-report", "compat"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0},
          "url": {"type": "string", "minLength": 1}
        }
      }
    },
    "checksums": {"const": "SHA256SUMS"},
    "self": {"type": "string", "minLength": 1}
  }
}
