{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gettakaro/connectors/catalog/schema/v1/inputs/maven-artifact.schema.json",
  "title": "Maven artifact input",
  "description": "A single jar from a Maven repository, addressed by group/artifact/version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "source", "hashOrigin", "group", "artifact", "version", "path", "sha256"],
  "properties": {
    "kind": {"const": "maven-artifact"},
    "source": {"type": "string", "minLength": 1},
    "hashOrigin": {"enum": ["upstream", "self-recorded"]},
    "group": {"type": "string", "minLength": 1},
    "artifact": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "path": {"type": "string", "pattern": "^/"},
    "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "size": {"type": "integer", "minimum": 1},
    "installPath": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*(/[A-Za-z0-9][A-Za-z0-9._+-]*)*$"}
  }
}
