{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gettakaro/connectors/catalog/schema/v1/inputs/http-file.schema.json",
  "title": "Plain HTTP file input",
  "description": "Any other file fetched by URL and pinned by sha256.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "source", "hashOrigin", "path", "sha256", "installPath"],
  "properties": {
    "kind": {"const": "http-file"},
    "source": {"type": "string", "minLength": 1},
    "hashOrigin": {"enum": ["upstream", "self-recorded"]},
    "path": {"type": "string", "pattern": "^/"},
    "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "size": {"type": "integer", "minimum": 1},
    "installPath": {"type": "string", "minLength": 1}
  }
}
