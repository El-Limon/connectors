{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gettakaro/connectors/catalog/schema/v1/inputs/github-source.schema.json",
  "title": "GitHub source archive input",
  "description": "A source tree at one exact commit, downloaded from <baseUrl>/<repo>/archive/<commit>.<archive>. A build input rather than an install input, so installPath is optional.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "source", "hashOrigin", "repo", "commit", "archive", "sha256"],
  "properties": {
    "kind": {"const": "github-source"},
    "source": {"type": "string", "minLength": 1, "description": "A game.json source whose provider is github-release."},
    "hashOrigin": {"enum": ["upstream", "self-recorded"]},
    "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "archive": {"enum": ["tar.gz", "zip"]},
    "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "size": {"type": "integer", "minimum": 1},
    "installPath": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*(/[A-Za-z0-9][A-Za-z0-9._+-]*)*$"}
  }
}
