{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gettakaro/connectors/catalog/schema/v1/target.schema.json",
  "title": "Catalog target record",
  "description": "One exactly pinned deployment target: which game build, which loader, which toolchain, which container, and how its bytes are verified.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "game", "platform", "revision", "default", "support", "inputs", "runtime", "build", "components", "verification", "preserve"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "game": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "platform": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "revision": {"type": "string", "minLength": 1},
    "default": {"type": "boolean"},
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "since", "evidence"],
      "properties": {
        "status": {"enum": ["candidate", "maintained", "retired"]},
        "since": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "string"}
      }
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "description": "One entry per pinned download. The kind names the schema file under inputs/ that the validator dispatches on, so a new kind means a new file there and never an edit to this one.",
      "additionalProperties": {
        "type": "object",
        "required": ["kind"],
        "properties": {"kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["java", "container"],
      "properties": {
        "java": {"type": ["integer", "null"], "minimum": 8, "description": "The JRE major version the server needs, or null for a game that ships its own runtime."},
        "container": {"$ref": "inputs/container-image.schema.json"}
      }
    },
    "build": {
      "type": "object",
      "required": ["system"],
      "description": "How the connector is built for this target. The system names the schema file under build-systems/ that the validator dispatches on, so a new build system means a new file there and never an edit to this one.",
      "properties": {"system": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}}
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "artifact", "installDir"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "artifact": {"type": "string", "pattern": "^(?=.*\\{version\\})[A-Za-z0-9][A-Za-z0-9._+{}-]*$"},
          "installDir": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*(/[A-Za-z0-9][A-Za-z0-9._+-]*)*$"}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "separate"],
      "properties": {
        "required": {"enum": ["build", "contract", "startup", "protocol", "gameplay"]},
        "separate": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "preserve": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "devServers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"gameId": {"type": "string", "minLength": 1}}
    },
    "notes": {"type": "string"}
  }
}
