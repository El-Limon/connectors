{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gettakaro/connectors/catalog/schema/v1/build-manifest.schema.json",
  "title": "Build manifest",
  "description": "What one `takaro-maint build` run produced: every artifact with its target, fingerprint and hash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "connector", "version", "sourceRevision", "dirty", "builtAt", "toolchain", "artifacts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "connector": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "sourceRevision": {"type": "string", "minLength": 1},
    "dirty": {"type": "boolean"},
    "builtAt": {"type": "string", "minLength": 20},
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag", "digest", "mode"],
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "mode": {"enum": ["host", "container"]}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "target", "fingerprint", "file", "sha256", "size"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "file": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
