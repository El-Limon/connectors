# syntax=docker/dockerfile:1
# What the release zip ships AS `Dockerfile`: a build from the packaged dist/, so the
# folder an operator unpacks builds on its own. The source Dockerfile next to this one
# compiles from src/, which the zip deliberately does not carry.
FROM node:22-alpine@sha256:b6f26b36c8ff49624cfdac716b8ea1138d606df02586a77d364bb5536a634f85
ENV NODE_ENV=production \
    TAKARO_PLUGIN_URL=http://127.0.0.1:18890 \
    TAKARO_CURSOR_FILE=/data/event-cursor.json \
    ENSHROUDED_LOG_FILE=/opt/enshrouded/server/logs/enshrouded_server.log
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY dist ./dist
RUN mkdir -p /data && chown node:node /data
USER node
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:${SIDECAR_HEALTH_PORT:-18891}/health >/dev/null || exit 1
CMD ["node", "dist/index.js"]
