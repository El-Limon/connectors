# Takaro Dune: Awakening connector — example environment.
# Copy to .env and fill in. Never commit a filled-in .env: four of these values are secrets.

# ---------------------------------------------------------------------------
# Takaro
# ---------------------------------------------------------------------------
TAKARO_REGISTRATION_TOKEN=            # registration token for a GENERIC game server
TAKARO_IDENTITY_TOKEN=dune            # identity this server registers with
TAKARO_WS_URL=wss://connect.takaro.io/
TAKARO_SERVER_NAME=Dune
# Players see this as the sender of connector messages. Set it to the SAME value as your Takaro
# game server's `serverChatName` setting, or Takaro's chat bridge will echo the connector's own
# lines back into the game.
TAKARO_SENDER_NAME=Server

# ---------------------------------------------------------------------------
# Battlegroup Postgres (READ-ONLY; the connector performs no DB writes)
# The DATABASE NAME is build-specific (`dune`, `dune_sb_1_5_3_0`, …) — look it up with `\l`.
# ---------------------------------------------------------------------------
DUNE_PG_URL=postgres://dune:CHANGE_ME@postgres:5432/dune
# DUNE_PG_SCHEMA=dune                 # schema the game's tables live in
# DUNE_PG_STATEMENT_TIMEOUT_MS=5000
# DUNE_PG_POOL_MAX=4
# DUNE_INVENTORY_TYPES=0,1,14,15,27,30  # 0 = backpack, the rest are gear/equipment containers

# ---------------------------------------------------------------------------
# Game RabbitMQ (chat in/out, and the AMQP GM publisher).
# The GAME broker, not the admin one.
# ---------------------------------------------------------------------------
DUNE_RMQ_URL=amqps://fls:CHANGE_ME@game-rmq:5672/
DUNE_RMQ_TLS_INSECURE=true            # the shipped broker certificate is self-signed
# DUNE_GLOBAL_MESSAGE_MODE=both       # chat | broadcast | both

# ---------------------------------------------------------------------------
# GM commands — the only write path into the game.
# Requires on EVERY map process: server.NotificationSystem.Enabled=true
#   and [FuncomLiveServices] ServerCommandsAuthToken=<this value>
# ---------------------------------------------------------------------------
DUNE_GM_AUTH_TOKEN=                   # == ServerCommandsAuthToken; SECRET
DUNE_GM_PUBLISHER=amqp                # amqp | docker-exec | kubectl-exec
# --- publisher = amqp: the broker validates the AMQP user_id, so an `fls` account must exist and
#     the broker's `internal` auth backend must be tried BEFORE the HTTP one. A stock Funcom k3s
#     install has neither, so use kubectl-exec there.
# DUNE_GM_AMQP_USER=fls
# DUNE_GM_AMQP_PASS=
# --- publisher = docker-exec: publish from inside the broker container (needs the Docker socket)
# DUNE_RMQ_CONTAINER=
# --- publisher = kubectl-exec: the same, on a stock Funcom k3s install
# DUNE_K8S_NAMESPACE=default
# DUNE_K8S_POD=
# DUNE_EXEC_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Optional native plugin (libtakaro-dune.so) — kill attribution, live position and precise
# connect/disconnect. Everything else works without it.
# The plugin binds LOOPBACK by default. Only widen the bind if the sidecar runs in a different
# network namespace, and never publish the port to the host.
# ---------------------------------------------------------------------------
# TAKARO_PLUGIN_BIND=127.0.0.1
# TAKARO_PLUGIN_PORT=18890
# DUNE_PLUGIN_URL=http://127.0.0.1:18890
# DUNE_PLUGIN_TOKEN=                  # required by the plugin; generate: openssl rand -hex 32
# DUNE_PLUGIN_TIMEOUT_MS=10000
# TAKARO_TICK_BUDGET_US=500           # per-tick game-thread budget the plugin may use

# ---------------------------------------------------------------------------
# Polling and verification
# ---------------------------------------------------------------------------
# DUNE_PRESENCE_INTERVAL_MS=5000      # how often the roster is diffed for connect/disconnect/death
# TAKARO_POLL_INTERVAL_MS=1000
# DUNE_TRANSFER_GRACE_SECONDS=45      # a map transfer must not look like a disconnect
# DUNE_VERIFY_WINDOW_MS=8000          # how long a mutation read-back may poll before it fails
# DUNE_BAN_KICK_COOLDOWN_MS=15000

# ---------------------------------------------------------------------------
# State — keep this volume, or bans are lost and events replay.
# ---------------------------------------------------------------------------
TAKARO_DATA_DIR=/data

# ---------------------------------------------------------------------------
# Item catalogue. The image ships a placeholder and generates the full one (see
# sidecar/data/ATTRIBUTION.md). Set to 0 to keep the placeholder.
# ---------------------------------------------------------------------------
# DUNE_CATALOGUE_AUTOGEN=1

# ---------------------------------------------------------------------------
# Log forwarding (optional). Dune has no documented log grammar, so lines are forwarded
# verbatim after redaction — nothing is parsed out of them.
# ---------------------------------------------------------------------------
# DUNE_LOG_FILE=                      # empty disables the log tail
# DUNE_LOG_EVENTS=filtered            # all | filtered | none

# ---------------------------------------------------------------------------
# Shutdown. Dune's own ServerShutdown GM command only draws a COUNTDOWN; nothing in the
# battlegroup halts the map process. Point this at your own stop hook, or the shutdown action
# refuses rather than pretending to have stopped anything.
# ---------------------------------------------------------------------------
# DUNE_SHUTDOWN_CMD=
# DUNE_SHUTDOWN_NOTICE_SECONDS=60

# ---------------------------------------------------------------------------
# Health endpoint and watchdog
# ---------------------------------------------------------------------------
SIDECAR_HEALTH_HOST=127.0.0.1
SIDECAR_HEALTH_PORT=18891
SIDECAR_EXIT_AFTER_DEPENDENCY_LOSS_MS=180000
DEBUG=0                               # 1 logs every wire frame (secrets are redacted regardless)
