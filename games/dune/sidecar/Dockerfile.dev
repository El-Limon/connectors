# syntax=docker/dockerfile:1
# Builds the sidecar from a source checkout (context = this directory).
FROM node:22-alpine AS build
WORKDIR /src
COPY package*.json tsconfig*.json ./
RUN npm ci
COPY src ./src
RUN npm run build

FROM node:22-alpine
ENV NODE_ENV=production \
    TAKARO_DATA_DIR=/data \
    DUNE_ITEMS_FILE=/app/data/items.json \
    DUNE_ENTITIES_FILE=/app/data/entities.json
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /src/dist ./dist
COPY data ./data
RUN mkdir -p /data && chown node:node /data
USER node
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:${SIDECAR_HEALTH_PORT:-18891}/health >/dev/null || exit 1
CMD ["node", "dist/index.js"]
