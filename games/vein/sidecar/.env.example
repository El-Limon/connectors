# --- Takaro ---
TAKARO_WS_URL=wss://connect.takaro.io/
TAKARO_IDENTITY_TOKEN=vein
TAKARO_REGISTRATION_TOKEN=
TAKARO_SERVER_NAME=Takaro Dev Vein
# Chat sender shown in game for sendMessage (falls back to TAKARO_SERVER_NAME, then "Server")
TAKARO_SENDER_NAME=Server

# --- Vein plugin (libtakaro-vein.so, loopback HTTP) ---
TAKARO_PLUGIN_URL=http://127.0.0.1:18890
TAKARO_PLUGIN_TOKEN=
TAKARO_PLUGIN_TIMEOUT_MS=10000
TAKARO_POLL_INTERVAL_MS=1000

# --- Vein game server ---
VEIN_LOG_FILE=/home/steam/vein/Vein/Saved/Logs/Vein.log
# Vein's own read-only HTTP API (Game.ini [/Script/Vein.VeinGameSession] HTTPPort). Empty disables it.
VEIN_HTTP_API=http://127.0.0.1:8080
VEIN_LOG_TAIL=auto
VEIN_LOG_EVENTS=filtered
# Optional log-grammar overrides (JS regex, named groups gameId/name/msg/channel). Leave empty to use the
# UE-standard defaults in src/vein/logTail.ts.
VEIN_LOG_LOGIN_RE=
VEIN_LOG_JOIN_RE=
VEIN_LOG_LEAVE_RE=
VEIN_LOG_CHAT_RE=
VEIN_LOG_READY_RE=

# --- Sidecar ---
TAKARO_CURSOR_FILE=/data/event-cursor.json
SIDECAR_HEALTH_PORT=18891
SIDECAR_HEALTH_HOST=127.0.0.1
# Self-restart watchdog (F17). With `network_mode: service:vein` the sidecar is pinned to the network namespace the
# game container had when it was created, and EVERY restart of that container creates a new one. After this long with
# BOTH the plugin and the game's own HTTP API unreachable, the sidecar exits(1) so `restart: unless-stopped`
# re-creates it in the live namespace. 0 disables it (only sane when the sidecar has its own network).
SIDECAR_EXIT_AFTER_UNREACHABLE_MS=45000
# Plugin down while the game's HTTP API still answers (namespace fine): a restart cannot help, so wait longer.
SIDECAR_EXIT_AFTER_PLUGIN_LOSS_MS=180000
