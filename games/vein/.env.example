# Takaro VEIN connector — example environment
# Copy to .env and fill in. Never commit a filled-in .env.

# --- Takaro ---
TAKARO_REGISTRATION_TOKEN=           # registration token for a GENERIC game server
TAKARO_IDENTITY_TOKEN=vein           # identity this server registers with
TAKARO_WS_URL=wss://connect.takaro.io/
TAKARO_SERVER_NAME=Vein

# --- shared secret between the plugin and the sidecar (same value in both) ---
TAKARO_PLUGIN_TOKEN=                 # generate: openssl rand -hex 32
TAKARO_PLUGIN_PORT=18890
TAKARO_PLUGIN_URL=http://127.0.0.1:18890
TAKARO_PLUGIN_TIMEOUT_MS=10000
TAKARO_POLL_INTERVAL_MS=1000
# TAKARO_SYM_PATH=                   # override where the plugin looks for symbols
# TAKARO_SENDER_NAME=Server          # sender name shown in game for broadcasts
# TAKARO_ITEM_NAMES=0                # 1 = readable item names (costs a call per item class at boot)
# TAKARO_BROADCAST_VIA=auto          # chat | servermessage | admin | auto
# TAKARO_PLUGIN_DEBUG=0              # 1 enables the token-gated /debug/* endpoints

# --- plugin: in-game admin ---
TAKARO_ADMIN_STEAMIDS=               # comma-separated SteamID64s, e.g. <your-steamid64>
# TAKARO_SUPERADMIN_STEAMIDS=

# --- sidecar state and logs ---
TAKARO_CURSOR_FILE=/data/event-cursor.json
VEIN_LOG_FILE=/home/steam/vein/Vein/Saved/Logs/Vein.log
VEIN_HTTP_API=http://127.0.0.1:8080  # VEIN's own read-only HTTP API; empty disables it
SIDECAR_HEALTH_HOST=127.0.0.1
SIDECAR_HEALTH_PORT=18891
SIDECAR_EXIT_AFTER_UNREACHABLE_MS=180000
DEBUG=0

# --- game server ---
VEIN_SERVER_NAME=Vein
VEIN_SERVER_PASSWORD=                # join password; leave empty for an open server
VEIN_MAXPLAYERS=16
VEIN_PUBLIC=true                     # false keeps the server off the public list (direct connect still works)
VEIN_PORT=7777
VEIN_QUERY_PORT=27015
