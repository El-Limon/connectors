# Takaro VEIN connector — example environment
# Copy to .env and fill in. Never commit a filled-in .env.

# --- Takaro ---
TAKARO_REGISTRATION_TOKEN=           # registration token for a GENERIC game server
TAKARO_IDENTITY_TOKEN=vein           # identity this server registers with
TAKARO_WS_URL=wss://connect.takaro.io/
TAKARO_SERVER_NAME=Vein
# TAKARO_SENDER_NAME=Server          # sender name shown in game for broadcasts
# TAKARO_SERVER_CHAT_NAME=           # chat name the connector's own messages use

# --- shared secret between the plugin and the sidecar (same value in both) ---
TAKARO_PLUGIN_TOKEN=                 # generate: openssl rand -hex 32
TAKARO_PLUGIN_PORT=18890             # plugin side: the loopback port it listens on
TAKARO_PLUGIN_URL=http://127.0.0.1:18890   # sidecar side: where it reaches the plugin
TAKARO_PLUGIN_TIMEOUT_MS=10000
TAKARO_POLL_INTERVAL_MS=1000
# TAKARO_RECONNECT_BASE_MS=2000      # WebSocket backoff, first delay
# TAKARO_RECONNECT_MAX_MS=60000      # WebSocket backoff, ceiling
# TAKARO_SYM_PATH=                   # override where the plugin looks for symbols
# TAKARO_ITEM_NAMES=0                # 1 = readable item names (costs a call per item class at boot)
# TAKARO_BROADCAST_VIA=auto          # chat | servermessage | admin | auto
# TAKARO_PLUGIN_DEBUG=0              # 1 enables the token-gated /debug/* endpoints

# --- plugin: in-game admin ---
TAKARO_ADMIN_STEAMIDS=               # comma-separated SteamID64s, e.g. <your-steamid64>
# TAKARO_SUPERADMIN_STEAMIDS=

# --- sidecar state (all under the /data volume; keep it, or events replay) ---
TAKARO_CURSOR_FILE=/data/event-cursor.json
# TAKARO_BAN_FILE=/data/bans.json
# TAKARO_ONLINE_FILE=/data/online.json
# TAKARO_KNOWN_PLAYERS_FILE=/data/known-players.json

# --- sidecar: game log and the game's own HTTP API ---
VEIN_LOG_FILE=/home/steam/vein/Vein/Saved/Logs/Vein.log
VEIN_HTTP_API=http://127.0.0.1:8080  # VEIN's own read-only HTTP API; empty disables it
VEIN_LOG_TAIL=auto                   # auto | on | off — the log tailer is a fallback
VEIN_LOG_EVENTS=filtered             # filtered | all | none — log lines forwarded to Takaro
# Optional log-grammar overrides (JS regex, named groups gameId/name/msg/channel).
# VEIN_LOG_LOGIN_RE=
# VEIN_LOG_JOIN_RE=
# VEIN_LOG_LEAVE_RE=
# VEIN_LOG_CHAT_RE=
# VEIN_LOG_READY_RE=

# --- sidecar: health endpoint and self-restart watchdog ---
SIDECAR_HEALTH_HOST=127.0.0.1
SIDECAR_HEALTH_PORT=18891
# With `network_mode: service:vein` every restart of the game container creates a new network
# namespace; after this long with both the plugin and the game's HTTP API unreachable the sidecar
# exits(1) so `restart: unless-stopped` re-creates it in the live one. Do not set it to 0.
SIDECAR_EXIT_AFTER_UNREACHABLE_MS=45000
# Plugin down while the game's HTTP API still answers: a restart cannot help, so wait longer.
SIDECAR_EXIT_AFTER_PLUGIN_LOSS_MS=180000
DEBUG=0

# --- game server ---
VEIN_SERVER_NAME=Vein
VEIN_SERVER_PASSWORD=                # join password; leave empty for an open server
VEIN_MAXPLAYERS=16
VEIN_PUBLIC=true                     # false keeps the server off the public list (direct connect still works)
VEIN_PORT=7777
VEIN_QUERY_PORT=27015
