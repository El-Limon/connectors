# Takaro Dragonwilds connector — example environment
# Copy to .env and fill in. Never commit a filled-in .env.

# --- Takaro ---
TAKARO_REGISTRATION_TOKEN=           # registration token for a GENERIC game server
TAKARO_IDENTITY_TOKEN=dragonwilds    # identity this server registers with
TAKARO_WS_URL=wss://connect.takaro.io/
TAKARO_SERVER_NAME=Dragonwilds

# --- shared secret between the plugin and the sidecar (same value in both) ---
TAKARO_PLUGIN_TOKEN=                 # generate: openssl rand -hex 32
TAKARO_PLUGIN_PORT=18890
TAKARO_PLUGIN_URL=http://127.0.0.1:18890
TAKARO_PLUGIN_TIMEOUT_MS=10000
TAKARO_POLL_INTERVAL_MS=1000
# TAKARO_SYM_PATH=                   # override the .sym location (default: next to the server binary)
# TAKARO_SENDER_NAME=                # sender name used for broadcasts (default: the server name)
# TAKARO_PLUGIN_DEBUG=0              # 1 enables the token-gated /debug/* endpoints

# --- sidecar state and logs ---
TAKARO_CURSOR_FILE=/data/event-cursor.json
TAKARO_ONLINE_FILE=/data/online.json
DRAGONWILDS_LOG_FILE=/game/RSDragonwilds/Saved/Logs/RSDragonwilds.log
SIDECAR_HEALTH_HOST=127.0.0.1
SIDECAR_HEALTH_PORT=18891
SIDECAR_EXIT_AFTER_UNREACHABLE_MS=180000
DEBUG=0

# --- game server ---
DRAGONWILDS_OWNER_ID=                # the owner's EOS ProductUserId (32 hex, client Settings screen)
DRAGONWILDS_SERVER_NAME=Dragonwilds
DRAGONWILDS_WORLD_NAME=World
DRAGONWILDS_WORLD_PASSWORD=
DRAGONWILDS_ADMIN_PASSWORD=
DRAGONWILDS_PORT=7777
