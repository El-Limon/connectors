{
  "schemaVersion": 1,
  "id": "takaro",
  "version": "${version}",
  "name": "Takaro Minecraft Connector",
  "description": "Takaro game server connector for Fabric",
  "environment": "server",
  "entrypoints": {
    "server": [
      "io.takaro.minecraft.fabric.TakaroFabricMod"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_min}",
    "fabric-api": ">=${fabric_api_min}",
    "minecraft": "${mc_version}",
    "java": ">=${java_min}"
  }
}
